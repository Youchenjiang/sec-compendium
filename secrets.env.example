# Framework secret template — copy to secrets.env (Git-ignored) and fill in values.
#
# Rules (.agent/mcp/README.md section 9):
#   - Only variable NAMES are tracked; values never enter version control.
#   - registry.json records the same names under `secrets_binding.env`, and a
#     server session receives only the names its own entry declares.
#   - Keys stay on the Primary Analysis Gateway; FLARE-VM and Kali hold none.
#   - Values are literal (no shell expansion); `#` comments and an optional
#     `export ` prefix are tolerated by the loader in security/tools/collab_mcp.py.

# --- framework paths and node access (security/tools/*, not MCP) ---
SECURITY_LAB_DATA_ROOT=
KALI_HOST=
KALI_USER=
KALI_PASSWORD=
VM_GP=
VM_GU=
VM_VMRUN=
VM_VMX=
VM_CREDS_FILE=

# --- semgrep MCP (optional: platform findings, remote and Pro features) ---
SEMGREP_APP_TOKEN=

# --- cve-mcp-server MCP (all optional; the keyless tools work without them) ---
NVD_API_KEY=
GITHUB_TOKEN=
VULNCHECK_TOKEN=
ABUSEIPDB_KEY=
VIRUSTOTAL_KEY=
URLSCAN_KEY=
SHODAN_KEY=
GREYNOISE_API_KEY=
CIRCL_PDNS_USER=
CIRCL_PDNS_PASS=

# --- Authorization Gate for command-capable MCP servers ---
# Leave unset until an allowlist entry exists in registry.authorization; approval
# is the presence of this variable plus `--authorized "<reason>"` on the call.
# MCP_AUTHORIZATION=
