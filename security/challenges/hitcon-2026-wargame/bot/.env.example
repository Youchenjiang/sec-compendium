# ==========================================================
# Wargame Bot Configuration Template
# Copy this file to .env and adjust for your target competition
# ==========================================================

# Competition Platform URL (defaults to HITCON 2026 wargame)
WARGAME_BASE_URL=https://wargame.d3vc0r3.tw
WARGAME_API_BASE=https://wargame.d3vc0r3.tw/api/v1
WARGAME_SUBMIT_URL=https://wargame.d3vc0r3.tw/submit

# User Credentials
WARGAME_EMAIL=your@email.com
WARGAME_PASSWORD=your_password

# Target Source Code Directory (e.g. extracted dist package)
WARGAME_DIST_DIR=/path/to/dist

# Generated Exploits & Output Directory (optional, defaults to bot/results)
WARGAME_EXPLOIT_DIR=
