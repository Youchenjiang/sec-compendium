# ==========================================================
# Code Auditor - Configuration Template
# Copy this file to .env and adjust for your target
# ==========================================================

# Competition / Target Platform URL (optional, for remote wargames/CTFs)
AUDITOR_BASE_URL=https://wargame.d3vc0r3.tw
AUDITOR_API_BASE=https://wargame.d3vc0r3.tw/api/v1
AUDITOR_SUBMIT_URL=https://wargame.d3vc0r3.tw/submit

# User Credentials
AUDITOR_EMAIL=your@email.com
AUDITOR_PASSWORD=your_password

# Target Source Code Directory (e.g. extracted dist package)
AUDITOR_DIST_DIR=/path/to/dist

# Generated Exploits & Output Directory (optional, defaults to results/)
AUDITOR_EXPLOIT_DIR=
